<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<div class="container">
  <div>
    <h1><%= t('.title') %></h1>
    <%= form_with url: login_path do |f| %>
      <div>
        <%= f.label t('.email') %>
        <%= f.email_field :email, class: "border border-solid form-control" %>
      </div>
      <div>
        <%= f.label t('.password') %>
        <%= f.password_field :password, class: "border border-solid form-control" %>
      </div>
      <%= f.submit t('.login'), class: "btn btn-primary" %>
      <!-- 今後、パスワードリセット機能ができたときに実装したい 
      <div>
      <%= link_to t('.to_register_page'), new_user_path %>
      <%= link_to t('.password_forget'), '#' %>
      </div>
      -->
    <% end %>
  </div>
</div>