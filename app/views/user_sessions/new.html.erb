<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<!-- ログイン画面のbodyタグの属性を指定 → application_html.erbに渡す -->
<%= content_for(:body_class, "user_sessions_new") %>

<div class="container m-auto">
  <div>
    <h1 class="text-3xl"><%= t('.title') %></h1>
    <%= form_with url: login_path do |f| %>
      <div>
        <%= f.label t('.email') %>
        <%= f.email_field :email, class: "form-control" %>
      </div>
      <div>
        <%= f.label t('.password') %>
        <%= f.password_field :password, class: "form-control" %>
      </div>
      <%= f.submit t('.login'), class: "button" %>
      <%= link_to t('.create'), new_user_path, class: "button" %>

      <!-- 今後、パスワードリセット機能ができたときに実装したい 
      <div>
      <%= link_to t('.create'), new_user_path %>
      <%= link_to t('.password_forget'), '#' %>
      </div>
      -->
    <% end %>
  </div>
</div>