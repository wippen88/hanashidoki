<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<!-- ログイン画面のbodyタグの属性を指定 → application_html.erbに渡す -->
<%= content_for(:body_class, "user_sessions_new") %>

<!-- 入力フォームの外枠をパーシャルで呼ぶ -->
<%= render "shared/form_container" do %>
  <!-- このブロックの中では、scope: "user_sessions.new" というオプションを、ブロック内で使う i18n に共通して持たせる -->
  <% with_options scope:"user_sessions.new" do |i18n| %>
    <h1 class="text-3xl"><%= i18n.t('title') %></h1>
    <%= form_with url: login_path, class: "flex flex-col" do |f| %>
      <div class="flex flex-col mx-auto">
        <div class="flex flex-col">
          <%= f.label i18n.t('email'), class: "form-label" %>
          <%= f.email_field :email, class: "form-control" %>
        </div>
        <div class="flex flex-col">
          <%= f.label i18n.t('password'),  class: "form-label" %>
          <%= f.password_field :password, class: "form-control" %>
        </div>
      </div>
      <div class="flex flex-col gap-6 mt-6 md:flex-row lg:flex-row">
        <%= f.submit i18n.t('login'), class: "button" %>
        <%= link_to i18n.t('create'), new_user_path, class: "button" %>
      </div>
      
      <!-- 今後、パスワードリセット機能ができたときに実装したい 
      <div class="flex flex-col">
      <%= link_to i18n.t('create'), new_user_path %>
      <%= link_to i18n.t('password_forget'), '#' %>
      </div>
      -->
    <% end %>
    <%= link_to i18n.t('to_top_page'), root_path, class: "underline text-xl" %>
  <% end %>
<% end %>