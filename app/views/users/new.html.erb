<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<!-- 新規登録画面のbodyタグの属性を指定 → application_html.erbに渡す -->
<%= content_for(:body_class, "user_create_new") %>

<!-- userをobjectという名前でパーシャルに渡す -->
<%= render "shared/form_errors", object: @user %>

<!-- 新規登録するユーザーのバリデーションエラーを表示する -->
<div class="container m-auto">
  <div class="bg-white w-md py-15 m-auto rounded-full inset-shadow-[0_0_30px_#f5c9c4]">
    <div class="flex flex-col items-center gap-6">
      <h1 class="text-3xl"><%= t('.title') %></h1>
      <%= form_with model: @user, class: "flex flex-col w-2xs" do |f| %>
        <div class="flex flex-col">
          <%= f.label t('.last_name'), class: "form-label" %>
          <%= f.text_field :last_name, class: "form-control", placeholder: t('.placeholder.last_name') %>
        </div>
        <div class="flex flex-col">
          <%= f.label t('.first_name'), class: "form-label" %>
          <%= f.text_field :first_name, class: "form-control", placeholder: t('.placeholder.first_name') %>
        </div>
        <div class="flex flex-col">
          <%= f.label t('.email'), class: "form-label" %>
          <%= f.email_field :email, class: "form-control", placeholder: t('.placeholder.email') %>
        </div>
        <div class="flex flex-col">
          <%= f.label t('.password'), class: "form-label" %>
          <%= f.password_field :password, class: "form-control", placeholder: t('.placeholder.password') %>
        </div>
        <div class="flex flex-col">
          <%= f.label t('.password_confirmation'), class: "form-label" %>
          <%= f.password_field :password_confirmation, class: "form-control" %>
        </div>
        <div class="flex gap-6 mt-4 justify-center">
          <%= f.submit t('.registration'), class: "button" %>
        </div>
      <% end %>
      <%= link_to t('.to_top_page'), root_path, class: "underline text-xl" %>
    </div>
  </div>
</div>