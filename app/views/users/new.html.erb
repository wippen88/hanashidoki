<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<!-- 新規登録画面のbodyタグの属性を指定 → application_html.erbに渡す -->
<%= content_for(:body_class, "user_create_new") %>

<!-- userをobjectという名前でパーシャルに渡す -->
<!-- 新規登録するユーザーのバリデーションエラーを表示する -->
<%= render "shared/form_errors", object: @user %>

<!-- 入力フォームの外枠をパーシャルで呼ぶ -->
<%= render "shared/form_container" do %>
  <!-- このブロックの中では、scope: "user_sessions.new" というオプションを、ブロック内で使うi18nに共通して持たせる -->
  <% with_options scope:"users.new" do |i18n| %>
    <h1 class="text-3xl"><%= i18n.t('title') %></h1>
    <%= form_with model: @user, class: "flex flex-col w-2xs gap-2" do |f| %>
      <div class="flex flex-col">
        <%= f.label i18n.t('last_name'), class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control", placeholder: i18n.t('placeholder.last_name') %>
      </div>
      <div class="flex flex-col">
        <%= f.label i18n.t('first_name'), class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control", placeholder: i18n.t('placeholder.first_name') %>
      </div>
      <div class="flex flex-col">
        <%= f.label i18n.t('email'), class: "form-label" %>
        <%= f.email_field :email, class: "form-control", placeholder: i18n.t('placeholder.email') %>
      </div>
      <div class="flex flex-col">
        <%= f.label i18n.t('password'), class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: i18n.t('placeholder.password') %>
      </div>
      <div class="flex flex-col">
        <%= f.label i18n.t('password_confirmation'), class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control" %>
      </div>
      <div class="flex gap-6 mt-4 justify-center">
        <%= f.submit i18n.t('registration'), class: "button" %>
      </div>
    <% end %>
    <%= link_to i18n.t('to_top_page'), root_path, class: "underline text-xl" %>
  <% end %>
<% end %>