<!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
<%= content_for(:title, t(".title")) %>

<div class="container">
  <div>
    <!-- 新規登録するユーザーのバリデーションエラーを表示する -->
    <!-- userをobjectという名前でパーシャルに渡す -->
    <%= render "shared/form_errors", object: @user %>

    <h1><%= t('.title') %></h1>
    <%= form_with model: @user do |f| %>
      <div>
        <%= f.label t('.last_name'), class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control border border-solid" %>
      </div>
      <div>
        <%= f.label t('.first_name'), class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control border border-solid" %>
      </div>
      <div>
        <%= f.label t('.email'), class: "form-label" %>
        <%= f.email_field :email, class: "form-control border border-solid" %>
      </div>
      <div>
        <%= f.label t('.password'), class: "form-label" %>
        <%= f.password_field :password, class: "form-control border border-solid" %>
      </div>
      <div>
        <%= f.label t('.password_confirmation'), class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control border border-solid" %>
      </div>
      <%= f.submit t('.registration'), class: "button" %>
    <% end %>
  </div>
</div>