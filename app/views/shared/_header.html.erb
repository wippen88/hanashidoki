<header>
  <nav class="bg-[#80989b] px-4 py-3">
    <div class="flex justify-between items-center">
      <%= link_to t('header.title'), root_path, class: "md:text-3xl lg:text-3xl text-nowrap text-2xl drop-shadow-[3px_3px_2px_#f5c9c4]" %>
      <div class="flex flex-col text-center items-center md:text-2xl lg:text-2xl md:flex-row lg:flex-row">
        <%= current_user.decorate.full_name %>
        <%= link_to t('header.logout'), logout_path, class: "button md:text-xl md:ml-6 lg:text-xl lg:ml-6", data: {turbo_method: :delete} %>  
      </div>
    </div>
  </nav>
</header>