<div class="container">
  <!-- viewで特定の名前を付与して、タイトルの内容を預ける -->
  <%= content_for(:title, t(".title")) %>

  <h1><%= t('.title') %></h1>

  <!-- StatusesControllerで取得した各ユーザーの話しかけていいステータスを、ループで表示する -->
  <% @statuses.each do |status| %>
    <div>
      <div>
        <!-- デコレーターでフルネームを表示する -->
        <%= status.user.decorate.full_name %>
        <!-- users_helperでモジュールを設定しているので、そこでステータスに紐づけたラベル名でステータスを表示 -->
        <!-- status.rbにenumで指定したものにステータスがあるので、さらに名前をつけた -->
        <%= status_label(status.busy_status) %>
        <%= status.status_message %>
      </div>
      <div>
        <% if status.user == current_user %>
        <%= link_to t('.status_edit'), edit_status_path %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>