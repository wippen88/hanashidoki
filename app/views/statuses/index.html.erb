<div class="container">
  <!-- StatusesControllerで取得した各ユーザーの話しかけていいステータスを、ループで表示する -->
  <% @statuses.each do |status| %>
    <div>
      <%= status.user.decorate.full_name %>
      <!-- users_helperでモジュールを設定しているので、そこでステータスに紐づけたラベル名でステータスを表示 -->
      <!-- status.rbにenumで指定したものにステータスさらに名前をつけた -->
      <%= status_label(status.busy_status) %>
      <%= status.status_message %>
    </div>
  <% end %>
</div>